// Blue Chip HR — data model
// ---------------------------------------------------------------------------
// Derived directly from the two workbooks the desk runs on today:
//   JOB DESCRIPTION SHEET.xlsx     → Client, Requirement
//   Recruiters Daily Report.xlsx   → Candidate, CandidateCall, Interview, Placement
//
// Two rules run through the whole thing:
//
//   MONEY IS NEVER A FLOAT. Rupees are Int. Percentages are basis points
//   (8.33% = 833). Floating point rounding in a fee calculation is how a
//   placement bills ₹49,999.97 and someone has to explain it to a client.
//
//   NOTHING THAT CAN BE COUNTED IS STORED. The "Daily productivity" tab and the
//   revenue column of "Recruiters MTD Performance" have no tables here. They are
//   queries over the rows below. That is the point of the app: the reports the
//   team types out by hand every day stop being typed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════════════
// PEOPLE WHO LOG IN
// ═══════════════════════════════════════════════════════════════════════════

// Deliberately NOT called Staff. Pulse has a Staff table for shop employees;
// these are different people in a different company in a different database,
// and the name difference is a guard against anyone ever wiring the two up.
model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  phone        String?
  passwordHash String
  role         String    @default("recruiter") // owner | manager | recruiter
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions   Session[]
  calls      CandidateCall[]
  candidates Candidate[]     @relation("CandidateOwner")
  placements Placement[]
  notes      ClientNote[]
  documents  Document[]

  attendance       Attendance[]
  salaryStructures SalaryStructure[]
  incentiveRules   IncentiveRule[]
  payrollItems     PayrollItem[]
  chatSent         ChatMessage[]     @relation("ChatAuthor")
  chatReceived     ChatMessage[]     @relation("ChatRecipient")
  reminders        Reminder[]
  submissions      Submission[]

  @@index([active, role])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ═══════════════════════════════════════════════════════════════════════════
// CLIENTS AND THEIR OPENINGS
// ═══════════════════════════════════════════════════════════════════════════

// One row per hiring company: AGS Health, Omega, Omega-Bangalore, Access,
// Acrologic, Navigant, Lapiz. The sheet repeats the company name on every
// opening; here it is said once.
model Client {
  id          String  @id @default(cuid())
  name        String  @unique
  hrName      String? // "HR NAME" column — the person the desk actually calls
  hrPhone     String?
  hrEmail     String?
  city        String?
  // House commercials. A requirement may override either field.
  //
  // feeType is nullable with NO default, deliberately. It began as
  // `String @default("percent")`, which meant every newly created client
  // claimed to be percentage-based before anyone had agreed a percentage:
  // "no terms yet" and "8.33%" were indistinguishable in the column, and a
  // non-nullable field cannot even be queried for the unset case.
  feeType     String? // percent | flat | null = not agreed yet
  feeBps      Int? // 8.33% → 833
  feeFlat     Int? // rupees, e.g. 8000
  paymentDays Int     @default(30) // credit period agreed with the client
  active      Boolean @default(true)

  // Needed to raise a correct tax invoice. state decides CGST+SGST versus IGST:
  // same state as the company is intra-state, anywhere else is inter-state.
  // Left null rather than defaulted — guessing a client's state picks their tax
  // treatment for them.
  gstin       String?
  state       String?
  address     String?

  notes        ClientNote[]
  requirements Requirement[]
  placements   Placement[]
  documents    Document[]
  submissions  Submission[]
  invoices     Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

model ClientNote {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  kind      String   @default("note") // note | meeting | escalation | payment | feedback
  body      String
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())

  @@index([clientId, createdAt])
}

// One opening. The sheet's two separate "PROCESS" columns meant two different
// things and could not both be filtered on; they are split here.
model Requirement {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  designation   String // AR Caller, Senior AR Caller, Team Lead…
  domain        String? // "RCM / Denials", "Provider AR"
  processType   String? // voice | non-voice | semi-voice      ← sheet col F
  processDetail String? // free text, e.g. "Denials management" ← sheet col M
  location      String
  openings      Int     @default(1)

  expMinMonths Int? // months, not years — "6 months to 1 year" is a real ask here
  expMaxMonths Int?

  // "CTC (Take Home)" — monthly rupees in hand. This is the number a recruiter
  // says on the phone, so it is the number stored; annual CTC is derived.
  takeHomeMin Int?
  takeHomeMax Int?
  shift       String? // day | night | rotational | US shift

  // Commercials for THIS opening. Null means "use the client's default".
  feeType String?
  feeBps  Int?
  feeFlat Int?

  // ── Knockout criteria ─────────────────────────────────────────────────────
  // In the spreadsheet these are prose in cells nobody can filter on, which is
  // why candidates get rejected in week two for something knowable in minute
  // one. As fields, the call screen can warn the recruiter immediately.
  relievingRequired Boolean @default(false) // "RELIEVING"
  arrearsAllowed    Boolean @default(true) // "ARREARS"
  educationMin      String? // "Any graduate", "No B.E/B.Tech"
  docsRequired      String? // comma-separated checklist
  cabFacility       String  @default("none") // none | oneway | twoway
  notes             String?

  // Shown on the public careers page. Off by default: an opening is internal
  // until someone decides otherwise, because the public version carries the
  // client's name and pay range to anyone who looks.
  publishOnline Boolean @default(false)

  status   String   @default("open") // open | hold | filled | closed
  priority String   @default("normal") // low | normal | high
  openedAt DateTime @default(now())
  closedAt DateTime?

  candidates  Candidate[]
  interviews  Interview[]
  placements  Placement[]
  submissions Submission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, clientId])
  @@index([location, status])
  @@index([designation])
}

// ═══════════════════════════════════════════════════════════════════════════
// CANDIDATES
// ═══════════════════════════════════════════════════════════════════════════

// The "Daily Call List" tab, normalised. One row per person, not per call —
// today the same candidate appears on four different days as four rows and
// nobody can tell it is one person.
model Candidate {
  id     String  @id @default(cuid())
  name   String
  phone  String
  email  String?
  altPhone String?

  designation  String? // what they do now
  location     String?
  expMonths    Int?
  currentCtc   Int? // monthly take-home, rupees
  expectedCtc  Int?
  noticeDays   Int?
  source       String? // naukri | referral | walk-in | database | linkedin | whatsapp
  skills       String?

  // Knockout answers, asked once and remembered. Matched against the
  // requirement's criteria so a mismatch surfaces before anyone books a slot.
  hasRelieving Boolean?
  hasArrears   Boolean?
  education    String?

  stage  String  @default("new") // new | contacted | shortlisted | lined-up | interviewed | selected | joined | dropped
  status String? // the free-text "status" column from the sheet, kept for nuance
  rating Int? // 1..5

  requirementId String?
  requirement   Requirement? @relation(fields: [requirementId], references: [id])

  ownerId String?
  owner   User?   @relation("CandidateOwner", fields: [ownerId], references: [id])

  resumeKey   String? // object-storage key, if a file was uploaded
  resumeText  String? // extracted text, for search

  lastContactedAt DateTime?
  // The single outstanding callback, rewritten on every logged call. Derived
  // from CandidateCall, but stored: "is a callback due?" is read on every load
  // of the busiest screen, and asking it of the call history means either a
  // correlated subquery or fetching every call of every candidate.
  nextFollowUpAt  DateTime?
  callCount       Int       @default(0) // denormalised for list sorting; CandidateCall is the truth
  archived        Boolean   @default(false)

  calls       CandidateCall[]
  interviews  Interview[]
  placements  Placement[]
  submissions Submission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // A phone number is one person. This is the constraint the spreadsheet lacks,
  // and the reason two recruiters currently call the same candidate on the same
  // morning without knowing.
  @@unique([phone])
  @@index([stage, archived])
  @@index([nextFollowUpAt])
  @@index([ownerId, lastContactedAt])
  @@index([requirementId])
  @@index([createdAt])
}

// Every dial. Counting these by day and recruiter IS the "No of Calls for the
// day" column, so nobody tallies it again at 7pm.
model CandidateCall {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id])

  calledAt DateTime @default(now())
  outcome  String // connected | no-answer | busy | wrong-number | not-interested | callback
  notes    String?
  followUpAt DateTime?

  @@index([userId, calledAt])
  @@index([candidateId, calledAt])
}

// ═══════════════════════════════════════════════════════════════════════════
// INTERVIEWS
// ═══════════════════════════════════════════════════════════════════════════

// The "Interview Schedules" tab. Company, position and phone are NOT copied in
// — they are reached through the candidate and the requirement, so they cannot
// drift apart the way they do across two spreadsheet tabs.
model Interview {
  id            String      @id @default(cuid())
  candidateId   String
  candidate     Candidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id])

  scheduledAt DateTime
  mode        String   @default("telephonic") // telephonic | direct | video
  location    String?
  round       Int      @default(1)
  interviewer String?

  // "Direct Line ups scheduled" and "Telephonic scheduled" on the productivity
  // tab are counts of this table by mode. "Intervw attend for the day" is the
  // count where attended = true.
  attended Boolean?
  outcome  String? // pending | selected | rejected | on-hold | no-show
  feedback String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([scheduledAt])
  @@index([requirementId, scheduledAt])
  @@index([candidateId])
  @@index([outcome])
}

// ═══════════════════════════════════════════════════════════════════════════
// PLACEMENTS — WHERE THE MONEY IS
// ═══════════════════════════════════════════════════════════════════════════

// The "Recruiters MTD Performance" tab. Nothing in Pulse corresponds to this;
// it is the half of the business that gets Blue Chip paid.
model Placement {
  id            String      @id @default(cuid())
  candidateId   String
  candidate     Candidate   @relation(fields: [candidateId], references: [id])
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id])
  clientId      String
  client        Client      @relation(fields: [clientId], references: [id])
  recruiterId   String
  recruiter     User        @relation(fields: [recruiterId], references: [id])

  selectedOn DateTime
  joinedOn   DateTime? // "D.O.J" — revenue is only real once this is set
  employeeId String? // issued by the client

  ctcOfferedAnnual Int // rupees per year
  takeHomeMonthly  Int?
  designation      String
  location         String

  // Terms FROZEN at selection, copied from the requirement or the client.
  // Deliberately not a lookup: when Blue Chip renegotiates a rate with Omega
  // next year, last year's placements must not silently re-price themselves.
  feeType  String // percent | flat
  feeBps   Int?
  feeFlat  Int?
  revenue  Int // computed once from the frozen terms, then stored

  invoiceStatus String    @default("pending") // pending | raised | paid | written-off
  invoiceNo     String?
  invoicedOn    DateTime?
  paidOn        DateTime?

  // Free-replacement window. If the candidate leaves inside it, Blue Chip owes
  // a replacement and the revenue is at risk — which is worth knowing before
  // the month closes, not after.
  replacementUntil DateTime?
  droppedOn        DateTime?
  dropReason       String?

  invoiceLines InvoiceLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([recruiterId, selectedOn])
  @@index([clientId, joinedOn])
  @@index([invoiceStatus])
  @@index([joinedOn])
}

// ═══════════════════════════════════════════════════════════════════════════
// HOUSEKEEPING
// ═══════════════════════════════════════════════════════════════════════════

// One row, id "singleton". The handful of numbers that are policy rather than
// data — how long a replacement is owed for, what the house credit period is —
// and which every placement copies at the moment it is created.
model Setting {
  id                 String   @id @default("singleton")
  companyName        String   @default("Blue Chip HR Solutions Pvt. Ltd.")
  // Free-replacement window, in days from the joining date. 90 is the usual
  // term in Indian staffing; 30 and 45 both exist. It is stored rather than
  // hard-coded because it is a commercial term, and commercial terms change.
  replacementDays    Int      @default(90)
  defaultPaymentDays Int      @default(30)

  // Public careers page at /jobs. Off until someone turns it on, because
  // turning it on publishes pay ranges and client names to the internet.
  careersEnabled     Boolean  @default(false)
  careersIntro       String?
  careersEmail       String?

  // Somewhere to connect an AI provider later. The key is stored here and
  // NEVER returned to the browser — the settings API sends only whether one is
  // present. Nothing consumes it yet; this is the socket, not the appliance.
  // Who the invoice is FROM. No defaults invented — an invoice with a made-up
  // GSTIN is worse than one that refuses to be raised until someone types the
  // real number in.
  gstin              String?
  stateName          String?
  stateCode          String?  // "33" for Tamil Nadu
  addressLine        String?
  bankName           String?
  bankAccount        String?
  bankIfsc           String?
  invoicePrefix      String   @default("BCH")
  gstBps             Int      @default(1800) // 18% on recruitment services

  // Outbound email. The password is stored here and NEVER returned to a
  // browser, same rule as the AI key.
  smtpHost     String?
  smtpPort     Int?
  smtpUser     String?
  smtpPassword String?
  smtpFrom     String?
  smtpSecure   Boolean @default(true)

  aiEnabled          Boolean  @default(false)
  aiProvider         String?  // anthropic | openai
  aiApiKey           String?

  updatedAt          DateTime @updatedAt
}

// Anything the desk needs to look up: client process notes, a handover before
// someone goes on leave, a training document, a scanned agreement.
//
// The FILE lives on disk, not in Postgres. A 4 MB PDF in a row makes every
// backup and every restore of the whole database slower, and the database is
// the thing that must come back fastest after a failure.
model Document {
  id          String   @id @default(cuid())
  title       String
  kind        String   @default("note") // note | handover | process | training | client | policy
  body        String? // for typed notes and handovers — searchable as-is
  // For uploads. storageKey is a path relative to the uploads directory, never
  // a path the client supplies.
  storageKey  String?
  filename    String?
  mimeType    String?
  bytes       Int?
  tags        String? // comma separated
  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id])
  authorId    String?
  author      User?    @relation(fields: [authorId], references: [id])
  pinned      Boolean  @default(false)
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([kind, archived])
  @@index([clientId])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String // create | update | delete | login | export | import
  entity    String // Candidate | Requirement | Placement …
  entityId  String?
  summary   String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId, createdAt])
  @@index([createdAt])
}

// Import of the existing workbooks, kept so a bad import can be identified and
// undone rather than hand-unpicked.
model ImportBatch {
  id         String   @id @default(cuid())
  kind       String // requirements | candidates | placements
  filename   String
  rowsTotal  Int      @default(0)
  rowsOk     Int      @default(0)
  rowsFailed Int      @default(0)
  errorsJson String   @default("[]")
  userId     String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════════════════════
// ATTENDANCE, PAY AND THE MONTHLY NUMBERS
// ═══════════════════════════════════════════════════════════════════════════

// One row per person per day. The unique constraint on (userId, day) is what
// stops a double check-in creating two rows and paying the day twice.
//
// `day` is a DATE at midnight IST, not a timestamp. Storing "the day this
// belongs to" separately from the check-in instant is what makes a night shift
// that crosses midnight still belong to the shift it started in.
model Attendance {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day      DateTime @db.Date
  checkIn  DateTime?
  checkOut DateTime?

  // present | leave | holiday | week-off | absent | half-day
  // leave/holiday/week-off are PAID and contribute a standard day.
  status   String   @default("present")
  note     String?

  // Who marked it, when it was not the person themselves. A manager correcting
  // a forgotten check-out should be visible as a correction, not indistinguishable
  // from the person's own tap.
  markedById String?
  source     String  @default("self") // self | manager | import

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, day])
  @@index([day])
  @@index([userId, day])
}

// What someone is paid, and from when. Never edited in place: a change writes a
// NEW row with a new effectiveFrom, so last month's payslip can still be
// recomputed from the figures that were true last month. Editing the salary in
// place is how a re-run of March quietly pays April's rate.
model SalaryStructure {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthlyGross       Int // rupees
  standardHoursPerDay Int     @default(8)
  workingDaysPerWeek  Int     @default(6)
  effectiveFrom      DateTime @db.Date
  note               String?
  createdById        String?
  createdAt          DateTime @default(now())

  @@index([userId, effectiveFrom])
}

// How incentive is earned. One rule may cover the whole desk (userId null) or
// one person (userId set); the person's own rule wins.
model IncentiveRule {
  id         String   @id @default(cuid())
  name       String
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       String // per-joining | percent-of-revenue | slab
  perJoining Int? // rupees per joined candidate
  revenueBps Int? // 5% = 500
  slabsJson  String   @default("[]") // [{ "min": 3, "amount": 5000 }]
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, active])
}

// A month, locked. Payroll is computed live on screen until someone locks it;
// after that the FIGURES ARE FROZEN into PayrollItem rows. A payslip that
// changes after it was handed over is not a payslip.
model PayrollRun {
  id        String   @id @default(cuid())
  month     String   @unique // "2026-09"
  status    String   @default("draft") // draft | locked | paid
  lockedAt  DateTime?
  lockedById String?
  paidOn    DateTime?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items PayrollItem[]
}

model PayrollItem {
  id     String     @id @default(cuid())
  runId  String
  run    PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  userId String
  user   User       @relation(fields: [userId], references: [id])

  // Every figure as it was at lock time. Copied, not joined — the whole point
  // of locking is that a later edit to the salary structure cannot reach back.
  monthlyGross   Int
  standardHours  Float
  workedHours    Float
  presentDays    Int @default(0)
  paidLeaveDays  Int @default(0)
  absentDays     Int @default(0)
  earnedBasic    Int
  incentive      Int @default(0)
  incentiveBasis String?
  joinings       Int @default(0)
  revenue        Int @default(0)
  deductions     Int @default(0)
  netPay         Int

  @@unique([runId, userId])
  @@index([userId])
}

// Desk chat. toUserId null = the whole desk; set = a direct message.
//
// Deliberately not a full messenger. It exists so "did you call the AGS
// candidate back?" happens inside the app next to the candidate, instead of on
// a personal WhatsApp where it is lost when someone leaves.
model ChatMessage {
  id        String   @id @default(cuid())
  authorId  String
  author    User     @relation("ChatAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  toUserId  String?
  toUser    User?    @relation("ChatRecipient", fields: [toUserId], references: [id], onDelete: Cascade)
  body      String
  // Optional pointer at what is being discussed, so a message can be opened.
  refType   String? // candidate | requirement | client | placement
  refId     String?
  deletedAt DateTime?
  createdAt DateTime @default(now())

  @@index([toUserId, createdAt])
  @@index([authorId, createdAt])
  @@index([createdAt])
}

// Last time each person read each conversation, so unread counts are real.
// peerKey is "desk" for the desk channel, otherwise the other person's id.
model ChatRead {
  id         String   @id @default(cuid())
  userId     String
  peerKey    String
  lastReadAt DateTime @default(now())

  @@unique([userId, peerKey])
}

// ═══════════════════════════════════════════════════════════════════════════
// WHAT IS DUE, WHAT WAS SENT, AND WHAT IS OWED
// ═══════════════════════════════════════════════════════════════════════════

// Something a person has to do, on a day. Generated by the nightly job from
// data the app already holds — an interview tomorrow, a follow-up due, a
// guarantee about to expire.
//
// The unique constraint is the whole design. The job runs every night and must
// be safe to run twice, by hand, at any time. Without it a manual re-run gives
// everyone a second copy of every reminder, they stop trusting the list, and
// the list stops working.
model Reminder {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // follow-up | interview | guarantee | invoice-due | attendance | no-response
  kind    String
  title   String
  body    String?
  dueOn   DateTime @db.Date
  // How loudly to say it. "now" is for things that are already late.
  urgency String   @default("normal") // now | normal | later

  refType String? // candidate | interview | placement | invoice | submission
  refId   String?

  status  String    @default("open") // open | done | dismissed
  doneAt  DateTime?
  createdAt DateTime @default(now())

  @@unique([userId, kind, refId, dueOn])
  @@index([userId, status, dueOn])
  @@index([dueOn])
}

// A CV going to a client, and what came back.
//
// This is the row the whole agency turns on. Two agencies claiming the same
// candidate is settled by who submitted first, and "I sent it on Tuesday" from
// someone's personal Gmail is not evidence. It is also the only way to see the
// thing nobody sees today: CVs sent into silence.
model Submission {
  id            String      @id @default(cuid())
  candidateId   String
  candidate     Candidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id])
  clientId      String
  client        Client      @relation(fields: [clientId], references: [id])

  sentById String?
  sentBy   User?    @relation(fields: [sentById], references: [id])
  sentAt   DateTime @default(now())
  method   String   @default("email") // email | whatsapp | portal | in-person
  toEmail  String?
  subject  String?

  // sent | acknowledged | shortlisted | interview-scheduled | rejected | no-response
  status      String    @default("sent")
  respondedAt DateTime?
  response    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The same candidate may genuinely be submitted to the same opening twice
  // (resubmitted after a gap), so this is an index, not a unique constraint —
  // but the screen warns before it happens.
  @@index([clientId, sentAt])
  @@index([candidateId, sentAt])
  @@index([requirementId, status])
  @@index([status, sentAt])
}

// ── invoicing ───────────────────────────────────────────────────────────────
//
// EVERY AMOUNT HERE IS IN PAISE, and every field says so in its name.
//
// The rest of this app keeps money in whole rupees, which is right for fees and
// salaries. It is wrong for a tax invoice: 18% GST on ₹2,34,912 is ₹42,284.16,
// and an invoice that silently drops those 16 paise is an invoice whose GST
// does not reconcile with the return filed against it. So invoices work in
// paise, the field names make that impossible to miss, and the rounding to a
// whole rupee is recorded explicitly as a round-off line — which is exactly
// what a printed Indian tax invoice does.
model Invoice {
  id       String @id @default(cuid())
  number   String @unique // BCH/2026-27/001 — gapless within a financial year
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  issuedOn DateTime @db.Date
  dueOn    DateTime @db.Date // issuedOn + the client's agreed credit period

  subtotalPaise Int
  gstBps        Int @default(1800) // 18% on recruitment services
  // Intra-state splits into CGST + SGST; inter-state is IGST. Which one applies
  // is decided by place of supply, not by preference, and getting it wrong
  // means filing the wrong return.
  cgstPaise     Int @default(0)
  sgstPaise     Int @default(0)
  igstPaise     Int @default(0)
  roundOffPaise Int @default(0)
  totalPaise    Int

  // Copied at issue, never joined. An invoice is a legal document about a
  // moment; if the client later changes address or GSTIN, the invoice already
  // sent must still say what it said.
  billToName   String
  billToGstin  String?
  billToState  String?
  billToAddress String?

  status   String    @default("draft") // draft | raised | paid | part-paid | written-off | cancelled
  paidOn   DateTime?
  paidPaise Int      @default(0)
  notes    String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lines InvoiceLine[]

  @@index([clientId, issuedOn])
  @@index([status, dueOn])
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  placementId String?
  placement   Placement? @relation(fields: [placementId], references: [id])
  description String
  amountPaise Int

  @@index([invoiceId])
  @@index([placementId])
}
