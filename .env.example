# Copy to .env on the server. provision-bluechip.sh writes this file for you.
DATABASE_URL="postgresql://bluechip:PASSWORD@127.0.0.1:5432/bluechip"
PORT=3100
NODE_ENV=production
APP_NAME="Blue Chip HR"

# Session signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me"

# Set to "false" only if serving over plain HTTP (e.g. through a tunnel while
# testing). Leave true in production or the session cookie can be stolen.
COOKIE_SECURE=true
